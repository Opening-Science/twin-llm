// Type checking for test files (#436). tsconfig.json leaves them out so the
// app typecheck stays fast; this config checks them with the same options.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Own cache, so the two checks do not overwrite each other's.
    "tsBuildInfoFile": "tsconfig.test.tsbuildinfo"
  },
  // Bun's own types (bun:test, Bun, import.meta.dir) for the test runner,
  // listed here only so app code does not see them.
  "files": ["node_modules/bun-types/index.d.ts"],
  // Test files and whatever they import, plus the module declarations the
  // open-twin packages keep beside their source. The tests copied from
  // open-twin import vitest and run under scripts/open-twin/test.ts, so they
  // stay out.
  "include": [
    "next-env.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "packages/open-twin/*/src/types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/open-twin/**/*.test.ts",
    "packages/open-twin/**/src/tests/**",
    ".open-twin"
  ]
}
