{
  "name": "twin-llm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=26 <27",
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "."
  ],
  "scripts": {
    "setup:local": "bun scripts/setup/local.ts",
    "doctor": "bun scripts/setup/doctor.ts",
    "dev": "next dev -H 127.0.0.1",
    "dev:http": "next dev -H 127.0.0.1",
    "dev:https": "next dev -H 127.0.0.1 --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "dev:behind-https": "next dev -H 127.0.0.1 -p 3011",
    "https:gateway": "HTTPS_GATEWAY_HOST=127.0.0.1 HTTPS_GATEWAY_PORT=3000 HTTPS_GATEWAY_UPSTREAM_PORT=3011 bun scripts/local-https-gateway.mjs",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:claims": "bun scripts/lint-claims.ts",
    "mcp:serve": "bun --preload ./features/chat/response/preload-server-only.mjs scripts/mcp-server.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "bun test infrastructure features features/chat/response tests/guardrails tests/guidelines tests/knowledge scripts/lint-claims.test.ts packages/warehouse packages/query-tools packages/audit packages/ark-adapter packages/genome-reference packages/carbon-x packages/gbd-mcp packages/mcp-client packages/guidelines packages/knowledge packages/vitronic scripts/vitronic packages/anatomy packages/biomarkers scripts/anatomy scripts/fonts scripts/warehouse scripts/evaluation scripts/synthea scripts/synthetic-wearables scripts/genome-synth scripts/training-data scripts/setup scripts/new-tool evaluation",
    "test:isolation": "bun test features/wearables features/vitronic features/oura features/whoop/oauth-route.test.ts features/google-health/oauth-route.test.ts",
    "postinstall": "prisma generate && bash scripts/flatten-open-twin.sh",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:verify": "bash scripts/db/verify-migrations.sh",
    "db:studio": "prisma studio",
    "verify:import": "bash scripts/verify-import.sh",
    "skills:check": "bun scripts/skills/check.ts",
    "new:tool": "bun scripts/new-tool/new-tool.ts",
    "new:tool:prove": "bun scripts/new-tool/prove-typecheck.ts",
    "tools:snapshots": "bun scripts/new-tool/write-snapshots.ts",
    "sync:open-twin": "bash scripts/sync-open-twin.sh",
    "sync:verify": "bun test infrastructure/open-twin-pins.test.ts",
    "flatten:open-twin": "bash scripts/flatten-open-twin.sh",
    "oura:proxy": "bun scripts/oura-oauth-proxy.mjs",
    "whoop:proxy": "bun scripts/whoop-oauth-proxy.mjs",
    "google-health:setup": "bun scripts/google-health-setup.mjs",
    "vitronic:connect": "bun --preload ./features/chat/response/preload-server-only.mjs scripts/vitronic/connect.ts",
    "vitronic:mint": "bun scripts/vitronic/mint-token.ts",
    "vitronic:cycle": "bun scripts/vitronic/cycle.ts",
    "anatomy:fetch": "bun scripts/anatomy/fetch.ts",
    "anatomy:bake-rigged": "bun scripts/anatomy/bake-rigged.ts",
    "fonts:install": "bun scripts/fonts/install.ts",
    "synthea:generate": "bash scripts/synthea/generate-local.sh",
    "wearables:generate": "bun scripts/synthetic-wearables/generate.ts",
    "genome:synth": "bun scripts/genome-synth/generate.ts",
    "genome:ingest": "bun scripts/genome-synth/ingest.ts",
    "genome:ingest:db": "bun --env-file=.env.training --preload ./features/chat/response/preload-server-only.mjs scripts/genome-synth/ingest.ts --to-db",
    "training:conversations": "bun --env-file=.env.training --preload ./features/chat/response/preload-server-only.mjs scripts/training-data/build-conversations.ts",
    "training:sample": "bun --preload ./features/chat/response/preload-server-only.mjs scripts/training-data/build-conversations.ts --cohort synthea-v4-seed42 --allow-eval-cohort --max-subjects 12 --out training-data/out/sample-synthea-v4-seed42.jsonl",
    "training:split": "bun scripts/training-data/split-conversations.ts",
    "training:batches": "bun --env-file=.env.training --preload ./features/chat/response/preload-server-only.mjs scripts/training-data/run-batches.ts",
    "warehouse:ingest": "bun --preload ./features/chat/response/preload-server-only.mjs scripts/warehouse/ingest.ts",
    "knowledge:ingest": "bun --preload ./features/chat/response/preload-server-only.mjs packages/knowledge/ingest-cli.ts",
    "eval:answer-key": "bun --env-file=.env.eval --preload ./features/chat/response/preload-server-only.mjs scripts/evaluation/build-answer-key.ts",
    "eval": "bun --env-file=.env.eval --preload ./features/chat/response/preload-server-only.mjs scripts/evaluation/run-eval.ts",
    "eval:report": "bun scripts/evaluation/run-report.ts",
    "eval:answer-key:live": "RUN_LIVE=1 bun --env-file=.env.eval test --preload ./features/chat/response/preload-server-only.mjs evaluation/answer-key.test.ts",
    "eval:spread-subjects": "bun --env-file=.env.eval --preload ./features/chat/response/preload-server-only.mjs scripts/evaluation/spread-subjects.ts",
    "knowledge:biomarkers": "bun scripts/knowledge/generate-biomarker-catalogue.ts",
    "ark:build": "bash apps/ark/rsid-genotypes/build.sh",
    "ark:test": "bash apps/ark/rsid-genotypes/test.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.60",
    "@arcjet/next": "1.9.1",
    "@clerk/nextjs": "7.6.4",
    "@googleapis/health": "2.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@open-twin/anchor-layer": "file:.open-twin/packages/anchor-layer",
    "@open-twin/fhir-core": "file:.open-twin/packages/fhir-core",
    "@open-twin/fhir-r4": "file:.open-twin/packages/fhir-r4",
    "@open-twin/interpretation-contract": "file:.open-twin/packages/interpretation-contract",
    "@open-twin/provider-google-health": "file:.open-twin/packages/provider-google-health",
    "@open-twin/provider-oura": "file:.open-twin/packages/provider-oura",
    "@open-twin/provider-vitronic": "file:.open-twin/packages/provider-vitronic",
    "@open-twin/provider-whoop": "file:.open-twin/packages/provider-whoop",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@posthog/ai": "8.6.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@react-three/fiber": "9.6.0",
    "@types/fhir": "0.0.44",
    "ai": "7.0.48",
    "clsx": "2.1.1",
    "googleapis": "173.0.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "posthog-js": "1.409.5",
    "posthog-node": "5.47.3",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "three": "0.184.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.184.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
