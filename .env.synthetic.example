# Synthetic demo: the model answers from the synthetic Synthea cohort only.
# Copy to .env.local in a fresh checkout or worktree — never commit .env.local.
# In this mode the chat route reads no wearable snapshot. See docs/runbook.md
# ("Synthetic demo") for copy, seed and run.

LOCAL_MVP=true
AUTH_DISABLED=true
NEXT_PUBLIC_LOCAL_MVP=true
NEXT_PUBLIC_AUTH_DISABLED=true
LOCAL_USER_ID=local

# Point at a database that holds only the synthetic warehouse (B1 seed).
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/twin_llm_synthetic

DATA_MODE=synthetic

# Its own state folder (#382), so its anchor key, signed anchors and vault never
# land in the default one (~/.local/share/twin-llm), which a personal install
# uses. Absolute path only: `~` and $HOME are not expanded in this file. Replace
# YOU with your user name (macOS: /Users/YOU/Library/Application Support/TwinLLM-synthetic).
# Left as is, commands stop with a permission error instead of using the default.
TWINLLM_STATE_DIR=/home/YOU/.local/share/twin-llm-synthetic

# Models, embeddings and storage stay on this machine. No cloud keys in this file.
LOCAL_ONLY=true
LLM_PROVIDER=ollama
# ollama pull qwen3:8b   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Context each chat asks Ollama for (default 16384; Ollama's own 4096 cuts the tools off).
# OLLAMA_NUM_CTX=16384

# --- Or: Exoscale (our own vLLM servers on the A30 instance in Switzerland) ---
# Off this machine, so LOCAL_ONLY must be false. See docs/providers.md ("Exoscale").
# LOCAL_ONLY=false
# LLM_PROVIDER=exoscale
# One https URL ending in /v1 per GPU; each model goes to the URL that lists it.
# EXOSCALE_BASE_URLS=
# Only if vLLM was started with --api-key:
# EXOSCALE_API_KEY=

# --- Or: remote GPU (vLLM on a rented GPU, reached through SSH tunnels) ---
# The model runs on someone else's machine, so this is synthetic data only and
# LOCAL_ONLY must be false. Open the tunnel first (docs/runbook.md, "Remote GPU").
# Guideline embeddings still use the Ollama URL above, on this machine.
# LOCAL_ONLY=false
# LLM_PROVIDER=remote-gpu
# One URL per tunnelled vLLM port; each model goes to the URL that lists it.
# REMOTE_GPU_BASE_URLS=http://127.0.0.1:8000/v1,http://127.0.0.1:8002/v1
# Only if vLLM was started with --api-key:
# REMOTE_GPU_API_KEY=

# --- IHME GBD population figures (eval scenario S4, docs/gbd.md) ---
# S4 runs by one of two routes. With neither, the run prints the unset names
# and writes every S4 item as MISSING_ENV (skipped, not failed).
#
# Local route (preferred, #387): no variables here. Import GBD 2023 Results
# Tool CSVs into the database above with scripts/gbd/import.ts
# (docs/evaluation/question-set.md, "Refresh"). The harness then offers
# gbd_estimate, needs no network or token, and LOCAL_ONLY=true can stay.
#
# Remote route: the IHME GBD MCP server over HTTPS, so S4 needs network
# access. Set both names below. A remote server stops the boot under
# LOCAL_ONLY=true, so set LOCAL_ONLY=false (LLM_PROVIDER=ollama keeps the model
# on this machine). DATA_MODE=synthetic is required: personal mode never gets
# a remote MCP server. Ask the operator for the URL and token; they are not
# derived from anything in this repository.
# LOCAL_ONLY=false
# GBD_MCP_URL=https://gbd-mcp.example.invalid/mcp
# GBD_MCP_TOKEN=
