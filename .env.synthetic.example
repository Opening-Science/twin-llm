# Synthetic demo: the model answers from the synthetic Synthea cohort only.
# Copy to .env.local in a fresh checkout or worktree — never commit .env.local.
# In this mode the chat route reads no wearable snapshot. See docs/runbook.md
# ("Synthetic demo") for copy, seed and run.

LOCAL_MVP=true
AUTH_DISABLED=true
NEXT_PUBLIC_LOCAL_MVP=true
NEXT_PUBLIC_AUTH_DISABLED=true
LOCAL_USER_ID=local

# Point at a database that holds only the synthetic warehouse (B1 seed).
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/twin_llm_synthetic

DATA_MODE=synthetic

# Models, embeddings and storage stay on this machine. No cloud keys in this file.
LOCAL_ONLY=true
LLM_PROVIDER=ollama
# ollama pull qwen3:8b   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Context each chat asks Ollama for (default 16384; Ollama's own 4096 cuts the tools off).
# OLLAMA_NUM_CTX=16384

# --- Or: Exoscale (our own vLLM servers on the A30 instance in Switzerland) ---
# Off this machine, so LOCAL_ONLY must be false. See docs/providers.md ("Exoscale").
# LOCAL_ONLY=false
# LLM_PROVIDER=exoscale
# One https URL ending in /v1 per GPU; each model goes to the URL that lists it.
# EXOSCALE_BASE_URLS=
# Only if vLLM was started with --api-key:
# EXOSCALE_API_KEY=

# --- Or: remote GPU (vLLM on a rented GPU, reached through SSH tunnels) ---
# The model runs on someone else's machine, so this is synthetic data only and
# LOCAL_ONLY must be false. Open the tunnel first (docs/runbook.md, "Remote GPU").
# Guideline embeddings still use the Ollama URL above, on this machine.
# LOCAL_ONLY=false
# LLM_PROVIDER=remote-gpu
# One URL per tunnelled vLLM port; each model goes to the URL that lists it.
# REMOTE_GPU_BASE_URLS=http://127.0.0.1:8000/v1,http://127.0.0.1:8002/v1
# Only if vLLM was started with --api-key:
# REMOTE_GPU_API_KEY=
