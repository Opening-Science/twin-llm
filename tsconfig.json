// Type checking only: Next (SWC) compiles, `tsc --noEmit` checks.
{
  "compilerOptions": {
    // Language and module system, as Next's bundler sees them.
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx", // Next requires the automatic runtime
    "resolveJsonModule": true, // fixtures and catalogues import JSON
    "esModuleInterop": true, // default imports from CommonJS packages
    "isolatedModules": true, // every file must compile on its own (SWC)
    "allowJs": true, // the .mjs scripts are checked too

    // Strictness: the coding standards require strict mode and no `any`.
    "strict": true, // all strict-family checks on

    // Speed and output.
    "noEmit": true, // checking only; SWC emits
    "skipLibCheck": true, // trust published .d.ts files
    "incremental": true, // reuse tsconfig.tsbuildinfo between runs

    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "next-env.d.ts", // generated by Next
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts", // route types from `next build`
    ".next/dev/types/**/*.ts" // route types from `next dev`
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    ".open-twin/**/tests",
    ".open-twin/**/*.test.ts",
    ".open-twin/**/vitest.config.ts",
    ".open-twin/**/testSetup.ts",
    ".open-twin/**/verification/**",
    ".open-twin/**/scripts/**"
  ]
}
