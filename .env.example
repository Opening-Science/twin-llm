# Copy to .env.local — never commit .env.local

# --- Local research MVP (recommended for TwinLLM demos / import verify) ---
LOCAL_MVP=true
AUTH_DISABLED=true
NEXT_PUBLIC_LOCAL_MVP=true
NEXT_PUBLIC_AUTH_DISABLED=true
LOCAL_USER_ID=local
# Auth off trusts every caller, so the server only answers loopback, same-origin
# requests and refuses to start under NODE_ENV=production (next start). Set this
# only for a production build on a machine nobody else can reach.
# ALLOW_AUTH_DISABLED_IN_PRODUCTION=true

# Required for prisma generate / app boot (placeholder OK for generate-only)
DATABASE_URL=postgresql://user:password@localhost:5432/twin_llm

# personal (default) | synthetic — personal forbids OpenRouter and remote-gpu.
# Both are allowed only when DATA_MODE=synthetic and no wearable snapshot is loaded.
# Any other value fails at startup.
DATA_MODE=personal

# --- Local only (recommended): models, embeddings and storage stay on this machine ---
# The app refuses to start with a cloud model provider, a non-loopback
# OLLAMA_BASE_URL, GBD_MCP_URL, or any PostHog / Arcjet / Clerk key.
# Wearable syncs still download from each vendor's cloud. See docs/providers.md.
LOCAL_ONLY=true

# exoscale | ollama | openrouter | remote-gpu | infomaniak (legacy)
# Default: ollama when LOCAL_ONLY=true, else exoscale (needs EXOSCALE_BASE_URLS, or startup fails).
# Import verify uses ollama in scripts/verify-import.sh so no cloud key is required.
LLM_PROVIDER=ollama

# --- LLM: Ollama (local) ---
# ollama pull qwen3:8b   (chat, Apache-2.0)   ollama pull nomic-embed-text   (guideline search)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- LLM: Exoscale (our own vLLM on an Exoscale GPU instance in Switzerland; set LOCAL_ONLY=false) ---
# Synthetic data only unless EXOSCALE_PERSONAL_DATA=consented-pilot. See docs/providers.md ("Exoscale").
# LLM_PROVIDER=exoscale
# consented-pilot lets personal data reach Exoscale, only for a pilot whose participants consented (default off).
# EXOSCALE_PERSONAL_DATA=off
# Comma list of https URLs ending in /v1, one vLLM server per GPU. Never a REMOTE_GPU_BASE_URLS entry.
# EXOSCALE_BASE_URLS=
# true only for an SSH tunnel to our own Exoscale VM: allows plain http on loopback (default false).
# EXOSCALE_ALLOW_LOOPBACK_TUNNEL=
# The vLLM --api-key, if the servers were started with one.
# EXOSCALE_API_KEY=
# Seconds to wait for the first byte of an answer before giving up (default 120, never retried).
# EXOSCALE_FIRST_BYTE_TIMEOUT_S=

# --- LLM: Infomaniak (legacy; cloud, Switzerland; DATA_MODE=synthetic, LOCAL_ONLY=false) ---
# Still works when named, but never a default. https://www.infomaniak.com/en/hosting/ai-services
# LLM_PROVIDER=infomaniak
# INFOMANIAK_API_TOKEN=
# INFOMANIAK_PRODUCT_ID=
# INFOMANIAK_BASE_URL=https://api.infomaniak.com/2/ai/{product_id}/openai/v1

# --- LLM: OpenRouter (cloud; DATA_MODE=synthetic, no wearable snapshot, LOCAL_ONLY=false) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# --- LLM: remote GPU (vLLM behind SSH tunnels; DATA_MODE=synthetic, LOCAL_ONLY=false) ---
# See .env.synthetic.example and docs/runbook.md ("Remote GPU").
# LLM_PROVIDER=remote-gpu
# REMOTE_GPU_BASE_URLS=http://127.0.0.1:8000/v1,http://127.0.0.1:8002/v1
# REMOTE_GPU_API_KEY=

# --- Sign-in and abuse protection (required when LOCAL_MVP=false and AUTH_DISABLED=false; off when LOCAL_ONLY=true) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# ARCJET_KEY=ajkey_

# --- Optional analytics: PostHog (never required; off when LOCAL_ONLY=true) ---
# Server events carry ids, counts and timings, never prompt or answer text.
# Model-call metrics are skipped entirely when DATA_MODE=personal.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Browser analytics stay off unless this is true (no autocapture or replay even then).
# NEXT_PUBLIC_POSTHOG_BROWSER=false

# --- Optional: Oura ---
# https://developer.ouraring.com/applications
# bun run oura:proxy (:8787 → /api/oura/callback)
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# OURA_REDIRECT_URI=http://localhost:8787/callback
# Generate with: openssl rand -hex 32 (64 hex characters)
# OURA_TOKEN_ENCRYPTION_KEY=

# --- Optional: Whoop (https redirect required) ---
# https://developer.whoop.com
# Register: https://localhost:8788/api/whoop/callback
# bun run whoop:proxy (TLS under ./certificates/, gitignored)
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=https://localhost:8788/api/whoop/callback
# Generate with: openssl rand -hex 32 (64 hex characters)
# WHOOP_TOKEN_ENCRYPTION_KEY=

# --- Optional: Google Health API v4 (Fitbit-linked; NOT Health Connect) ---
# https://developers.google.com/health-api
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/google-health/callback
# Generate with: openssl rand -hex 32 (64 hex characters)
# GOOGLE_HEALTH_TOKEN_ENCRYPTION_KEY=

# Note: prisma migrate is out of scope for import verification (#1b).
# Use: bun run db:generate  (or bun run verify:import)

# --- Optional: IHME GBD MCP (population estimates only) ---
# GBD_MCP_URL=
# GBD_MCP_TOKEN=

# --- Optional: Vitronic BodyLoop (per-user API token; never a password grant) ---
# Generate with: openssl rand -hex 32 (64 hex characters)
# VITRONIC_TOKEN_ENCRYPTION_KEY=
# Default: data/vitronic
# VITRONIC_DATA_DIR=
# Comma-separated scanner hosts. When set, only these hosts are accepted as the
# scanner base URL (and a loopback or link-local host only if listed here).
# VITRONIC_SCANNER_HOSTS=
# Mint CLI only (password never stored by the app): bun scripts/vitronic/mint-token.ts
# BODYLOOP_BASE_URL=
# BODYLOOP_USERNAME=
# BODYLOOP_PASSWORD=
# BODYLOOP_TOKEN_NAME=
# BODYLOOP_TLS_FINGERPRINT=
# Live scanner test (never CI): RUN_LIVE=1 bun test packages/vitronic/live.test.ts
# VITRONIC_BASE_URL=
# VITRONIC_API_TOKEN=
# VITRONIC_PROBAND_ID=
# VITRONIC_TLS_FINGERPRINT=
# Connect CLI: bun run vitronic:connect
# LOCAL_USER_ID=local

# --- Optional: reference-anatomy atlases (bun run anatomy:fetch) ---
# Default: data/anatomy
# ANATOMY_DATA_DIR=
