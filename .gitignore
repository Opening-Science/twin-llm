# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
certificates/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# env files — keep only the example
.env
.env.*
!.env.example
!.env.synthetic.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client (postinstall / db:generate)
/generated

# Pinned open-twin checkout (see scripts/sync-open-twin.sh)
.open-twin/

# Local Synthea output (scripts/synthea/generate-local.sh)
.synthea/

# Generated training conversations (scripts/training-data/build-conversations.ts)
/training-data/out/

# local junk / oversized assets
public/assets.zip
skills-lock.json
.turbo

# Ark WASI app build output (do not commit wasm)
apps/ark/rsid-genotypes/build/
apps/ark/rsid-genotypes/target/
# BodyLoop avatar blobs (hashed .glb; never commit scans)
data/vitronic/
# Guideline full text (operator-extracted UTF-8; never commit PDFs or body text)
data/guidelines/
# Reference-anatomy atlases (CC BY 4.0, fetched by bun run anatomy:fetch; never commit)
data/anatomy/

# eval harness output (C3a): runs and recorded model calls stay local
evaluation/runs/
evaluation/cache/

# Licensed brand fonts (bun run fonts:install); never commit the files
/public/fonts/*
!/public/fonts/README.md


# Python workspace (python/README.md)
python/.venv/
__pycache__/
.pytest_cache/

# Motion clips made from videos (python/motion); third-party footage stays local
data/motion/
