// TwinLLM database schema.
//
// Sections, top to bottom:
//   1. People: an app user keyed by their Clerk id, plus first-run answers.
//   2. Conversations: threads of turns. A turn stores the question once and
//      gets one ModelResponse row per model that was asked.
//   3. Personal context: wearables (Oura, Whoop, Google Health), BodyLoop
//      scans, released Ark genome reports and the files a person imports
//      (personal_*). Tokens are AES-GCM ciphertext, never plain text.
//   4. Research warehouse: synthetic Synthea cohorts only.
//   5. Retrieval: guideline and OpenTwin knowledge chunks with pgvector.
//   6. Tool audit log, hash-chained.
//
// Things Prisma cannot express live as hand-written SQL in the baseline
// migration: the pgvector extension, vector(768), the HNSW index and the
// warehouse source CHECK constraints. `bun run db:verify` checks all of them.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 1. People ──────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  /// Clerk user id, or the fixed local actor when auth is disabled.
  clerkId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingProfile OnboardingProfile?
  threads           Thread[]

  ouraConnection         OuraConnection?
  ouraSnapshots          OuraSnapshot[]
  whoopConnection        WhoopConnection?
  whoopSnapshots         WhoopSnapshot[]
  googleHealthConnection GoogleHealthConnection?
  googleHealthSnapshots  GoogleHealthSnapshot[]
  vitronicConnection     VitronicConnection?
  vitronicSubjects       VitronicSubject[]
  vitronicSnapshots      VitronicSnapshot[]
  genomeReports          GenomeReport[]
  personalDatasets       PersonalDataset[]
  skills                 UserSkill[]
  twinNotes              TwinNote[]
  learningConsents       LearningConsent[]
  scheduledTasks         ScheduledTask[]

  @@map("users")
}

/// What a user said in the /start flow. At most one row per user.
model OnboardingProfile {
  id     String @id @default(cuid())
  userId String @unique

  roles           String[]  @default([])
  dataChoice      String?
  interest        String?
  /// Knowledge sources this user switched off. Stored as an opt-out list so a
  /// source added later is on by default.
  disabledSources String[]  @default([])
  /// Set when the person turned off loading their twin notes into new chats (#43).
  twinNotesOff    Boolean   @default(false)
  /// Live public lookups this user switched on (#6). Stored as an opt-in list,
  /// so every live source, and any added later, is off by default.
  liveSources     String[]  @default([])
  /// Last step reached, so the flow can resume.
  step            Int       @default(0)
  /// Set when the user finishes or skips the flow.
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_profiles")
}

// ─── 2. Conversations ───────────────────────────────────────────────────────

/// A conversation belonging to one user.
model Thread {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns            Turn[]
  searchEmbeddings ThreadSearchEmbedding[]
  scheduledTasks   ScheduledTask[]

  @@index([userId, updatedAt])
  @@map("threads")
}

/// One embedding of a prompt or an answer, for the search box (#167). Holds
/// no text: the snippet is read back from turns or model_responses, so
/// deleting a thread (cascade) removes everything search knows about it.
/// Embedded only by Ollama on this machine. Genome threads are never indexed.
model ThreadSearchEmbedding {
  id              String                 @id @default(cuid())
  userId          String                 @map("user_id")
  threadId        String                 @map("thread_id")
  /// "prompt" (sourceId is a turn id) or "answer" (a model_responses id).
  sourceKind      String                 @map("source_kind")
  sourceId        String                 @map("source_id")
  model           String
  /// vector(768) in the database, with an HNSW cosine index, set in the
  /// migration SQL because Prisma has no syntax for either. Synthetic
  /// installs only; null in personal mode (#141).
  embedding       Unsupported("vector")?
  /// Personal mode (#141): the vector as sealed JSON; search runs in memory
  /// after unlock.
  embeddingSealed String?                @map("embedding_sealed")
  createdAt       DateTime               @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([sourceKind, sourceId])
  @@index([userId])
  @@map("thread_search_embeddings")
}

/// One question in a thread. Each model asked gets its own ModelResponse.
model Turn {
  id        String   @id @default(cuid())
  threadId  String
  prompt    String
  createdAt DateTime @default(now())
  /// Set when a scheduled task (#54) asked this, not the person typing.
  scheduled Boolean  @default(false)

  thread    Thread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  responses ModelResponse[]

  @@index([threadId, createdAt])
  @@map("turns")
}

enum ModelResponseStatus {
  STREAMING
  COMPLETE
  FAILED
  /// Refused before any model ran (data-mode policy or a skill rule). The
  /// row's text holds TwinLLM's own refusal sentence, never a provider message.
  REFUSED

  @@map("model_response_status")
}

/// The answer one model gave to one turn, with its measurements.
model ModelResponse {
  id        String @id @default(cuid())
  turnId    String
  modelId   String
  modelName String

  status ModelResponseStatus @default(STREAMING)
  text   String              @default("")

  /// Index in the list of models picked for the turn, so a saved thread keeps
  /// that order. Null on rows written before the column existed.
  position Int?

  /// The "## Reasoning" section, when the model used the expected format.
  reasoningText    String?
  /// Wearable metrics the answer cited: [{ metricKey, label, value, observationId? }].
  /// JSON text; sealed in personal mode like every personal column (#141).
  attribution      String?
  /// Validated ResponseDocumentV1 (docs/response-schema.md). Null when it was
  /// not built or the row predates it. JSON text.
  responseDocument String?
  /// Tool calls of the turn with their inputs and outputs, in step order:
  /// [{ seq, tool, input, output, argsSha256, resultSha256, rowCount, at }].
  /// Null when the answer used no tool or the row predates it. JSON text.
  toolParts        String?

  // Measurements. Null means not measured, never zero.
  timeToFirstTokenMs Int?
  tokensPerSecond    Decimal? @db.Decimal(10, 2)
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  costUsd            Decimal  @default(0) @db.Decimal(10, 6)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  turn Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, modelId])
  @@map("model_responses")
}

// ─── 3. Personal context ────────────────────────────────────────────────────

/// Linked Oura account. Both tokens are encrypted at rest.
model OuraConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  accessTokenEnc       String
  refreshTokenEnc      String
  /// Estimated expiry of the access token.
  accessTokenExpiresAt DateTime
  /// Stable non-identifying key used for FHIR subject ids.
  subjectKey           String?

  linkedAt   DateTime  @default(now())
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oura_connections")
}

/// Oura data for a date window, condensed for the chat prompt.
model OuraSnapshot {
  id         String   @id @default(cuid())
  userId     String
  startDate  String
  endDate    String
  /// Metric values keyed so answers can cite them. JSON text, sealed in
  /// personal mode (#141).
  summary    String
  /// Full FHIR Bundle. Server-side only, never sent to a model. JSON text.
  fhirBundle String?
  syncedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, syncedAt])
  @@map("oura_snapshots")
}

/// Linked Whoop account. Both tokens are encrypted at rest.
model WhoopConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  accessTokenEnc       String
  refreshTokenEnc      String
  accessTokenExpiresAt DateTime

  linkedAt   DateTime  @default(now())
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whoop_connections")
}

/// Whoop data for a date window, condensed for the chat prompt.
model WhoopSnapshot {
  id         String   @id @default(cuid())
  userId     String
  startDate  String
  endDate    String
  /// JSON text, sealed in personal mode (#141).
  summary    String
  /// Full FHIR Bundle. Server-side only. JSON text.
  fhirBundle String?
  syncedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, syncedAt])
  @@map("whoop_snapshots")
}

/// Linked Google Health (Fitbit) account. Both tokens are encrypted at rest.
model GoogleHealthConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  accessTokenEnc       String
  refreshTokenEnc      String
  accessTokenExpiresAt DateTime
  /// Stable non-identifying key for FHIR subject ids. Never an email address.
  subjectKey           String?

  linkedAt   DateTime  @default(now())
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_health_connections")
}

/// Google Health data for a date window, condensed for the chat prompt.
model GoogleHealthSnapshot {
  id         String   @id @default(cuid())
  userId     String
  startDate  String
  endDate    String
  /// JSON text, sealed in personal mode (#141).
  summary    String
  fhirBundle String?
  syncedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, syncedAt])
  @@map("google_health_snapshots")
}

/// A user's BodyLoop scanner link. Holds an encrypted per-user API token;
/// no BodyLoop password is ever stored.
model VitronicConnection {
  id      String @id @default(cuid())
  userId  String @unique
  baseUrl String

  apiTokenEnc          String
  /// Encrypted shared secret for cloud_connect uploads.
  uploadSecretEnc      String
  /// Token name, when the token was minted with the host-only CLI.
  apiTokenName         String?
  /// SHA-256 of the scanner's TLS certificate (DER), pinned on first connect.
  tlsFingerprintSha256 String?
  /// BodyLoop proband id: a number, not a name.
  probandId            Int

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vitronic_connections")
}

/// A person whose body scans the user may view, with recorded consent.
/// `label` is free text chosen by the operator and must not be a name.
model VitronicSubject {
  id     String @id @default(cuid())
  userId String
  label  String
  source String

  /// True for the user's own subject. `selfForUserId` equals `userId` exactly
  /// when this is true; its unique index allows one self subject per user.
  isSelf        Boolean @default(false)
  selfForUserId String? @unique

  /// BodyLoop proband id. Null for subjects imported from files only.
  probandId       Int?
  /// Scan the Digital Twin viewer opens first. Display preference only; chat
  /// always uses the newest snapshot.
  defaultViatarId Int?

  consentRecordedAt DateTime
  consentBy         String
  consentNote       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots VitronicSnapshot[]

  @@index([userId, isSelf])
  @@map("vitronic_subjects")
}

/// One BodyLoop scan (viatar) for a subject. The mesh file stays on disk under
/// data/vitronic/<userId>/ (sealed in personal mode, #141); only the hash of
/// its plaintext is stored here.
model VitronicSnapshot {
  id        String @id @default(cuid())
  userId    String
  subjectId String
  viatarId  Int

  /// Numeric `vitronic.*` keys the chat prompt may read. JSON text, sealed
  /// in personal mode (#141), like markers, measures and the bundle.
  summary    String
  /// Viewer-only geometry. Never included in a prompt.
  markers    String?
  measures   String?
  presetName String?
  /// Intentionally left null: the provider maps BodyLoop lengths in metres and
  /// angles in radians, while the BodyLoop UI shows cm and degrees.
  fhirBundle String?

  glbSha256    String?
  /// Which BodyLoop model file the mesh came from.
  glbModelName String?

  syncedAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject VitronicSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, viatarId])
  @@index([subjectId, syncedAt])
  @@index([userId, syncedAt])
  @@map("vitronic_snapshots")
}

/// A report the owner released from their Ark after a phone approval: the
/// rsid-genotypes app's table, kept so the app is not re-run on every visit.
/// Personal data. Written only with DATA_MODE=personal and GENOME_SOURCE=ark,
/// read only by this machine's dashboard and its local genome tools. Never
/// sent to a hosted model, MCP server or analytics.
/// A released report belongs to a user, or (synthetic only) to a synthetic
/// cohort subject; a CHECK constraint in the migration allows exactly one of
/// the two, and `isSynthetic` is true exactly when it is a subject's.
model GenomeReport {
  id          String  @id @default(cuid())
  userId      String?
  /// A synthetic subject's report (scripts/genome-synth); null for a user's own.
  subjectRef  String?
  isSynthetic Boolean @default(false)
  /// Ark app that produced it, e.g. rsid-genotypes.
  app         String
  /// The build the Ark named for its call slot, as written; null when it named none.
  arkBuild    String?
  /// Parsed rows: rsid, chromosome, position, reference, genotype (null is no call).
  /// JSON text; sealed for a user's own report in personal mode (#141).
  rows        String
  /// The released text exactly as the app printed it.
  report      String

  releasedAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectRef], references: [subjectRef], onDelete: Cascade)

  @@index([userId, app, releasedAt])
  @@index([subjectRef, app, releasedAt])
  @@map("genome_reports")
}

/// One file a person imported on Customize · Data (#176, #178, #179, #180, docs/personal-data.md).
/// Personal data, written only with DATA_MODE=personal, owned by one user and
/// never mixed with the synthetic warehouse. Deleting it hard-deletes its rows
/// (cascade). `sha256` is the uploaded file's, so the same file twice is
/// recognised. CHECK constraints in the migration hold `kind` and `status`.
model PersonalDataset {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  /// "fhir", "lab-csv", "table", "apple-health", "wearable" or "vcf".
  kind           String
  name           String
  sourceFileName String   @map("source_file_name")
  /// The file's SHA-256; sealed in personal mode (#141).
  sha256         String
  /// Keyed hash of the file's SHA-256, so the same file twice is recognised
  /// without reading `sha256`. Null only on rows a migration has not reached.
  sha256Index    String?  @map("sha256_index")
  byteSize       Int      @map("byte_size")
  /// "ready": written whole in one transaction.
  status         String   @default("ready")
  /// Rows stored: observations plus clinical records, or table rows.
  rowCount       Int      @map("row_count")
  /// Earliest and latest date stored, ISO text as the review showed it.
  firstAt        String?  @map("first_at")
  lastAt         String?  @map("last_at")
  /// "GRCh38" for a VCF (the only build imported); null for every other kind.
  genomeBuild    String?  @map("genome_build")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations    PersonalObservation[]
  clinicalRecords PersonalClinicalRecord[]
  table           PersonalTable?
  tableChunks     PersonalTableChunk[]
  variants        PersonalVariant[]

  @@unique([userId, sha256Index])
  @@index([userId, createdAt])
  @@map("personal_datasets")
}

/// A number from an imported FHIR file or lab CSV. The unit is stored as the
/// file wrote it and never converted; `unitUcum` says whether it is UCUM.
/// `code` is null when the file gave none and the explicit name table had none.
model PersonalObservation {
  id                 String   @id @default(cuid())
  datasetId          String   @map("dataset_id")
  userId             String   @map("user_id")
  codeSystem         String?  @map("code_system")
  code               String?
  display            String
  /// The number as text; sealed in personal mode (#141).
  value              String
  unit               String
  unitUcum           Boolean  @map("unit_ucum")
  effectiveAt        DateTime @map("effective_at")
  /// "year", "month", "day" or "instant": how much of the date the file gave.
  effectivePrecision String   @map("effective_precision")
  /// A FHIR id or "row 12".
  sourceRef          String   @map("source_ref")
  note               String?
  /// Keyed hash of the code (system and code) or, for a row without one, of
  /// its name: what the chat tools look a series up by (#141).
  lookupIndex        String?  @map("lookup_index")
  /// Keyed hash of system, code, name and unit: one series, for grouping.
  seriesIndex        String?  @map("series_index")

  dataset PersonalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([userId, lookupIndex, effectiveAt])
  @@index([userId, datasetId, seriesIndex])
  @@map("personal_observations")
}

/// A FHIR Condition or MedicationRequest from an imported file, as recorded.
model PersonalClinicalRecord {
  id           String    @id @default(cuid())
  datasetId    String    @map("dataset_id")
  userId       String    @map("user_id")
  /// "Condition" or "MedicationRequest".
  resourceType String    @map("resource_type")
  codeSystem   String?   @map("code_system")
  code         String?
  display      String
  /// Condition onset, or MedicationRequest authoredOn.
  startAt      DateTime? @map("start_at")
  /// Condition abatement.
  endAt        DateTime? @map("end_at")
  status       String?
  sourceRef    String    @map("source_ref")

  dataset PersonalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("personal_clinical_records")
}

/// The columns of an imported research table: name, inferred type
/// ("number", "date", "text") and missing count, in file order.
model PersonalTable {
  datasetId String @id @map("dataset_id")
  userId    String @map("user_id")
  /// JSON text, sealed in personal mode (#141).
  columns   String
  rowCount  Int    @map("row_count")

  dataset PersonalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@map("personal_tables")
}

/// Up to 1,000 rows of an imported research table, as a JSON array of arrays
/// in column order (null for a missing cell).
model PersonalTableChunk {
  id         String @id @default(cuid())
  datasetId  String @map("dataset_id")
  userId     String @map("user_id")
  chunkIndex Int    @map("chunk_index")
  /// JSON text, sealed in personal mode (#141).
  rows       String

  dataset PersonalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, chunkIndex])
  @@map("personal_table_chunks")
}

/// One record of an imported genome VCF (#180, docs/personal-data.md): the
/// person's genotype at one GRCh38 site. Genome data: read only by a model on
/// this machine under `permitGenomeRequest`, never by the imported-data chat
/// tools and never sent to a hosted provider. QUAL, INFO, the other FORMAT
/// fields and the sample's name are not stored.
model PersonalVariant {
  id             String   @id @default(cuid())
  datasetId      String   @map("dataset_id")
  userId         String   @map("user_id")
  /// As the file names it: "chr1" or "1".
  chrom          String
  /// 1-based GRCh38 position, as text; sealed in personal mode (#141).
  pos            String
  /// The ID column, such as an rsID; null when ".".
  variantId      String?  @map("variant_id")
  ref            String
  /// Alternate alleles as written, comma separated.
  alt            String
  /// GT as written ("0/1", "1|1"); null for a no-call.
  genotype       String?
  /// The FILTER column; null when ".".
  filter         String?
  /// Keyed hash of `chrom:pos` as the file wrote it (#141).
  siteIndex      String?  @map("site_index")
  /// Keyed hash of each ID in the ID cell (split on ";").
  variantIdIndex String[] @default([]) @map("variant_id_index")

  dataset PersonalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([userId, siteIndex])
  @@index([variantIdIndex], type: Gin)
  @@map("personal_variants")
}

// ─── 4. Research warehouse (synthetic only) ─────────────────────────────────

/// A cohort member with an opaque reference. Personal wearable data never
/// lands in the warehouse; ingest always sets `isSynthetic`.
model Subject {
  subjectRef  String  @id @map("subject_ref")
  cohortId    String  @map("cohort_id")
  isSynthetic Boolean @map("is_synthetic")
  /// FHIR Patient.gender (female, male, other, unknown); synthetic subjects only (#4).
  sex         String?
  /// Year of Patient.birthDate; the full date is never stored.
  birthYear   Int?    @map("birth_year")
  /// Year of Patient.deceasedDateTime; null while alive or when not given.
  deathYear   Int?    @map("death_year")

  observations       Observation[]
  nonNumeric         ObservationNonNumeric[]
  conditions         Condition[]
  medicationRequests MedicationRequest[]
  /// Synthetic genome reports (scripts/genome-synth), never a person's.
  genomeReports      GenomeReport[]

  @@index([cohortId])
  @@map("subjects")
}

/// An ingested Synthea Bundle, identified by the SHA-256 of its bytes.
model Bundle {
  sha            String   @id
  cohortId       String   @map("cohort_id")
  syntheaVersion String   @map("synthea_version")
  ingestedAt     DateTime @default(now()) @map("ingested_at")

  observations       Observation[]
  nonNumeric         ObservationNonNumeric[]
  conditions         Condition[]
  medicationRequests MedicationRequest[]

  @@map("bundles")
}

/// A numeric Observation. A UCUM unit is required; a value without one is
/// rejected at ingest rather than stored. `source` is limited to 'synthea' by
/// a CHECK constraint in the migration.
model Observation {
  id          String   @id @default(cuid())
  subjectRef  String   @map("subject_ref")
  bundleSha   String   @map("bundle_sha")
  fhirId      String   @map("fhir_id")
  source      String
  loinc       String
  display     String
  value       Decimal  @db.Decimal(20, 8)
  unitUcum    String   @map("unit_ucum")
  effectiveAt DateTime @map("effective_at")

  subject Subject @relation(fields: [subjectRef], references: [subjectRef], onDelete: Cascade)
  bundle  Bundle  @relation(fields: [bundleSha], references: [sha], onDelete: Cascade)

  @@unique([bundleSha, fhirId])
  @@index([subjectRef, loinc, effectiveAt])
  @@map("observations")
}

/// An Observation whose value is not a number (coded, text, boolean, ...).
/// Same 'synthea' CHECK on `source` as Observation.
model ObservationNonNumeric {
  id         String @id @default(cuid())
  subjectRef String @map("subject_ref")
  bundleSha  String @map("bundle_sha")
  fhirId     String @map("fhir_id")
  source     String
  loinc      String
  display    String
  valueType  String @map("value_type")
  rawValue   Json   @map("raw_value")

  subject Subject @relation(fields: [subjectRef], references: [subjectRef], onDelete: Cascade)
  bundle  Bundle  @relation(fields: [bundleSha], references: [sha], onDelete: Cascade)

  @@unique([bundleSha, fhirId])
  @@map("observation_non_numeric")
}

/// A Synthea Condition as recorded. Synthetic only through its subject
/// (`subjects.is_synthetic`); `source` is checked to be 'synthea' in SQL.
model Condition {
  id                 String    @id @default(cuid())
  subjectRef         String    @map("subject_ref")
  bundleSha          String    @map("bundle_sha")
  fhirId             String    @map("fhir_id")
  source             String
  codeSystem         String    @map("code_system")
  code               String
  display            String
  onsetAt            DateTime? @map("onset_at")
  abatementAt        DateTime? @map("abatement_at")
  clinicalStatus     String?   @map("clinical_status")
  verificationStatus String?   @map("verification_status")
  encounterRef       String?   @map("encounter_ref")

  subject Subject @relation(fields: [subjectRef], references: [subjectRef], onDelete: Cascade)
  bundle  Bundle  @relation(fields: [bundleSha], references: [sha], onDelete: Cascade)

  @@unique([bundleSha, fhirId])
  @@index([subjectRef, onsetAt])
  @@map("conditions")
}

/// A Synthea MedicationRequest as recorded. `dosage_text` is the record's
/// `dosageInstruction[].text`, verbatim; no other dosing field is kept.
model MedicationRequest {
  id         String    @id @default(cuid())
  subjectRef String    @map("subject_ref")
  bundleSha  String    @map("bundle_sha")
  fhirId     String    @map("fhir_id")
  source     String
  codeSystem String    @map("code_system")
  code       String
  display    String
  authoredAt DateTime? @map("authored_at")
  status     String?
  intent     String?
  dosageText String[]  @map("dosage_text")
  reasonRefs String[]  @map("reason_refs")

  subject Subject @relation(fields: [subjectRef], references: [subjectRef], onDelete: Cascade)
  bundle  Bundle  @relation(fields: [bundleSha], references: [sha], onDelete: Cascade)

  @@unique([bundleSha, fhirId])
  @@index([subjectRef, authoredAt])
  @@map("medication_requests")
}

// ─── 5. Retrieval ───────────────────────────────────────────────────────────

/// A searchable document: a published guideline or an OpenTwin knowledge note.
/// Guideline full text is only kept (in gitignored data/guidelines/) when its
/// licence allows; otherwise the row is cite-only.
model GuidelineDocument {
  id      String @id
  /// "guideline" or "opentwin-knowledge". Each search tool filters on it.
  source  String @default("guideline")
  title   String
  society String
  year    Int
  doi     String
  url     String
  licence String

  ingestMode     String @map("ingest_mode")
  embeddingModel String @map("embedding_model")
  embeddingDim   Int    @map("embedding_dim")

  chunks GuidelineChunk[]

  @@index([source])
  @@map("guideline_documents")
}

/// A verbatim passage with its embedding (nomic-embed-text, local Ollama).
model GuidelineChunk {
  id               String                @id
  documentId       String                @map("document_id")
  sectionHeading   String                @map("section_heading")
  recommendationId String?               @map("recommendation_id")
  recClass         String?               @map("rec_class")
  evidenceLevel    String?               @map("evidence_level")
  page             String?
  text             String
  /// vector(768) in the database. The column size and the HNSW cosine index
  /// (guideline_chunks_embedding_hnsw) are set in migration SQL because Prisma
  /// has no syntax for either.
  embedding        Unsupported("vector")

  document GuidelineDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("guideline_chunks")
}

// ─── 6. Audit ───────────────────────────────────────────────────────────────

/// Append-only record of every data tool call. Each row's `hash` is
/// sha256(prevHash + canonical JSON of the row without `hash`); the first row
/// chains from 64 zeros. Writers serialise through a Postgres advisory lock.
model AuditEvent {
  seq        BigInt   @id @default(autoincrement())
  ts         DateTime @default(now())
  actor      String
  sessionId  String   @map("session_id")
  subjectRef String?  @map("subject_ref")
  tool       String

  argsSha256   String @map("args_sha256") @db.Char(64)
  resultSha256 String @map("result_sha256") @db.Char(64)
  rowCount     Int    @map("row_count")

  prevHash String @map("prev_hash") @db.Char(64)
  hash     String @db.Char(64)

  @@map("audit_events")
}

/// The disclosure ledger (#140, docs/privacy-design.md 2.5): one row per event
/// in which data leaves this machine (a hosted model, a wearable vendor, an
/// export file, telemetry, a remote tool) or the person's Ark releases a
/// report into it. Hash-chained like `audit_events` (`packages/audit/chain.ts`)
/// and written in one transaction with its paired audit row, before the send.
/// Never the content: recipient, purpose, categories, counts and size. `refs`
/// (which stored values the request carried, as references) is sealed in
/// personal mode (#141) and is not part of the hash, so a key rotation can
/// reseal it; `ref_count` is.
model DisclosureEvent {
  seq             BigInt   @id
  /// Row id, part of the sealed `refs` context.
  id              String   @unique
  ts              DateTime
  actor           String
  /// "hosted-model", "vendor-sync", "vendor-auth", "export-file", "ark-release",
  /// "remote-tool", "embedding", "telemetry" or "public-lookup" (`DISCLOSURE_KINDS`).
  kind            String
  /// "sent", or "received" for an Ark release.
  direction       String
  recipient       String
  /// The model id, request kind or file format, when there is one.
  target          String?
  purpose         String
  categories      String[]
  refCount        Int      @map("ref_count")
  /// Request or file size in bytes; null when it could not be measured.
  payloadBytes    Int?     @map("payload_bytes")
  threadId        String?  @map("thread_id")
  /// True when the request carried synthetic data only.
  synthetic       Boolean
  /// True when the request's free text was checked for stored values (#346).
  freeTextChecked Boolean  @map("free_text_checked")
  /// What the check found: `[{ kind, count }]`, never a value; null when it
  /// did not run. In the hash only when set.
  freeTextMatches Json?    @map("free_text_matches")
  /// Sealed JSON list of `{ category, key }`; null when there are none.
  refs            String?
  /// The `seq` of the audit row written in the same transaction.
  auditSeq        BigInt   @map("audit_seq")
  prevHash        String   @map("prev_hash") @db.Char(64)
  hash            String   @db.Char(64)

  @@index([actor, recipient])
  @@map("disclosure_events")
}

/// A skill a person made on Customize (#174). The same fields as a SKILL.md
/// frontmatter plus its instructions, checked by the same schema on save and
/// again before it runs. Only its owner sees or runs it.
model UserSkill {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  description  String
  instructions String
  tools        String[]
  sources      String[]
  providers    String[]
  views        String[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("user_skills")
}

/// A twin note (#43, docs/twin-notes.md): the person's confirmed summary of a
/// thread, made with `/compact` and edited on Customize · Memory. Lines of
/// text only, never tool rows. `dataMode` and `permit` say which turns may
/// load it: a note keeps the permit of the thread it came from.
model TwinNote {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  title          String
  /// The three lists are JSON arrays of text, sealed in personal mode (#141).
  topics         String
  measures       String
  openQuestions  String   @map("open_questions")
  /// "synthetic" or "personal": DATA_MODE when it was saved.
  dataMode       String   @map("data_mode")
  /// "synthetic", "personal" or "local" (`notePermitFor`).
  permit         String
  /// The thread it was made from; kept as a plain id, so deleting the thread
  /// leaves the person's note.
  sourceThreadId String?  @map("source_thread_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("twin_notes")
}

/// Consent to learn from personal data (#145, docs/privacy-design.md 2.4). Off by
/// default: no active row means no consent. A row is never edited except to set
/// `withdrawnAt`; granting again after a withdrawal adds a new row. Plaintext on
/// purpose: it holds fixed choices and a shipped sentence, no health data, and the
/// gate must read it from a command line where the vault is not open.
model LearningConsent {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  /// "training", "answer-key" or "evaluation" (`LEARNING_SCOPES`).
  scope          String
  /// What it covers, from `LEARNING_SOURCES` ("wearables", "imports", ...).
  sources        String[]
  /// The exact sentence shown when it was granted, its wording version and SHA-256.
  wording        String
  wordingVersion String    @map("wording_version")
  wordingSha256  String    @map("wording_sha256") @db.Char(64)
  grantedAt      DateTime  @default(now()) @map("granted_at")
  withdrawnAt    DateTime? @map("withdrawn_at")
  /// The `seq` of the audit row that granted it.
  auditSeq       BigInt    @map("audit_seq")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@map("learning_consents")
}

/// A scheduled run of a skill (#54, docs/skills.md "Scheduled tasks"): the skill,
/// the thread its answers go to, when it runs and whether it may notify. Created by
/// the person only; nothing is scheduled by default and notifications start off.
/// `question` is sealed in personal mode (#141); the rest holds no health data.
model ScheduledTask {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  /// Null until the first run starts a new thread.
  threadId        String?   @map("thread_id")
  skill           String
  /// What the run asks with the skill; sealed in personal mode.
  question        String
  modelId         String    @map("model_id")
  /// "daily", "weekly" or "interval" (`scheduleSchema`).
  scheduleKind    String    @map("schedule_kind")
  /// "HH:MM" on the person's clock, for daily and weekly.
  timeOfDay       String?   @map("time_of_day")
  /// 0 is Sunday, for weekly.
  weekday         Int?
  intervalMinutes Int?      @map("interval_minutes")
  timeZone        String    @map("time_zone")
  enabled         Boolean   @default(false)
  notify          Boolean   @default(false)
  nextRunAt       DateTime? @map("next_run_at")
  /// Set while a run is in flight; cleared when it ends or the server restarts.
  runningSince    DateTime? @map("running_since")
  lastRunAt       DateTime? @map("last_run_at")
  /// "complete", "failed", "refused", "skipped-locked" or "interrupted".
  lastStatus      String?   @map("last_status")
  lastTurnId      String?   @map("last_turn_id")
  /// A finished run the person asked to hear about and has not seen yet.
  unseen          Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([enabled, nextRunAt])
  @@map("scheduled_tasks")
}
