{
  "name": "Excess Monitor",
  "remarks": [
    "Instrumentation for issue 323, outside the repo. Once a month, on the same 1-month delay cycle as stroke.json, it routes through states that name the stroke_risk bin and the calculator's flags. It writes nothing to the record and draws no random numbers; read it back from the JSON exporter's module history."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Tick"
    },
    "Tick": {
      "type": "Delay",
      "exact": {
        "quantity": 1,
        "unit": "months"
      },
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "And",
            "conditions": [
              {
                "condition_type": "Age",
                "operator": ">=",
                "quantity": 50,
                "unit": "years"
              },
              {
                "condition_type": "Date",
                "operator": ">=",
                "year": 2014
              },
              {
                "condition_type": "Attribute",
                "attribute": "stroke_risk",
                "operator": "is not nil"
              }
            ]
          },
          "transition": "Risk"
        },
        {
          "transition": "Tick"
        }
      ]
    },
